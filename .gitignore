# ==========================================
# Root .gitignore for Sessions Marketplace
# ==========================================

# Sensitive Credential Files (Crucial to ignore)
.env
.env.local
.env.*
.env.development.local
.env.test.local
.env.production.local
*.env
backend/.env

# Custom Local Database Cluster (Crucial to ignore)
backend/local_db/
local_db/
db.sqlite3
db.sqlite3-journal
*.sqlite3
*.sqlite3-journal

# Python (Backend) virtualenv & packages
backend/venv/
venv/
ENV/
.venv/
pip-log.txt
pip-delete-this-directory.txt

# Python cache & compiled files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Node.js (Frontend) dependencies & build outputs
frontend/node_modules/
node_modules/
frontend/.next/
.next/
frontend/out/
out/
frontend/build/
build/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# System & IDE files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Testing & logs
frontend/coverage/
coverage/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
